# Optional settings for the Node server. Production hosts should set NODE_ENV=production.
PORT=3000

# Development-only Vite setting; set to true to disable HMR.
DISABLE_HMR=false

# Optional Cloudflare Radar API token for enhanced network analytics
# Get your token from https://dash.cloudflare.com/profile/api-tokens
# Free tier: 5,000 requests/month
CLOUDFLARE_RADAR_API_TOKEN=
